{minimum_otp_vsn, "26.0"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{profiles, [
    {test, [{erl_opts, [debug_info]}]}
]}.

{hex, [{doc, edoc}]}.

{project_plugins, [rebar3_hex, rebar3_ex_doc]}.

{ex_doc, [
    {extras, [<<"README.md">>, <<"LICENSE">>]},
    {main, <<"readme">>},
    {source_url, <<"https://github.com/OpenRiak/riak_clients">>}
]}.
