{minimum_otp_vsn, "26.0"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{profiles, [
    {test, [{erl_opts, [debug_info]}]}
]}.

%% Pin rebar3_hex 7.2.0 (hex_core 0.18). 7.3.0 + hex_core 0.19 breaks
%% publish auth (missing cli_auth_callbacks). Same pin as lexbor_erl.
{plugins, [
    {rebar3_hex, "7.2.0"},
    rebar3_ex_doc
]}.

{ex_doc, [
    {source_url, <<"https://github.com/OpenRiak/riak_clients">>},
    {extras, [<<"README.md">>, <<"LICENSE">>]},
    {main, <<"readme">>},
    {homepage_url, <<"https://github.com/OpenRiak/riak_clients">>},
    {api_reference, true}
]}.

{hex, [
    {doc, edoc},
    {exclude_files, [
        "_build",
        ".git",
        ".github",
        "test",
        "doc",
        "*.beam",
        ".DS_Store",
        "erl_crash.dump",
        "rebar3.crashdump"
    ]}
]}.
