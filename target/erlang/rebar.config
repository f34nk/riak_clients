{minimum_otp_vsn, "26.0"}.

{erl_opts, [
    debug_info,
    {i, "src"}
]}.

{deps, [
    {jsone, "1.9.0"}
]}.

{profiles, [
    {test, [{erl_opts, [debug_info]}]}
]}.

%% Pin rebar3_hex 7.4.0. 7.2.0 crashes on publish when both hexpm and
%% hexpm:hexpm repos are configured (case_clause in repo/2).
{plugins, [
    {rebar3_hex, "7.4.0"},
    rebar3_ex_doc
]}.

{ex_doc, [
    {source_url, <<"https://github.com/f34nk/riak_clients">>},
    {extras, [<<"README.md">>, <<"LICENSE">>]},
    {main, <<"readme">>},
    {homepage_url, <<"https://github.com/f34nk/riak_clients">>},
    {api_reference, true}
]}.

{hex, [
    {doc, edoc},
    {exclude_files, [
        "_build",
        ".git",
        ".github",
        "test",
        "doc",
        "*.beam",
        ".DS_Store",
        "erl_crash.dump",
        "rebar3.crashdump"
    ]}
]}.
